# ─── Google AdSense ──────────────────────────────────────────────────────────
# The publisher ID (already correct for this account).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-2747147036042508

# The numeric ad slot ID. REQUIRED — ads render nothing until this is set.
# Find it in AdSense → Ads → By ad unit → your unit → the `data-ad-slot`
# value in the snippet Google shows you. Digits only, e.g. 1234567890.
NEXT_PUBLIC_ADSENSE_SLOT=

# ─── Build tuning ────────────────────────────────────────────────────────────
# Optional cap on how many service × city × locality pages are pre-rendered at
# build time. Leave unset to pre-render all ~6,076. Set a number (e.g. 2000)
# if the build exceeds your host's time limit — pages beyond the cap are still
# served, generated on first request and then cached by ISR.
# SSG_SUBCITY_LIMIT=
